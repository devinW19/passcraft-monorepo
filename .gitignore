# ==========================================
# 1. System & Global Files
# ==========================================
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ==========================================
# 2. Frontend & Node Backend (React / Express)
# ==========================================
# Dependencies
**/node_modules/
**/jspm_packages/

# Production / Build outputs
**/dist/
**/build/
**/.next/
**/.out/

# Frontend testing & coverage
**/coverage/

# ==========================================
# 3. Python Backend (Flask)
# ==========================================
# Byte-compiled / optimized / DLL files
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Environments (Virtual environments)
**/.venv/
**/venv/
**/ENV/
**/env/

# Python distribution / packaging
**/develop-eggs/
**/.eggs/
**/downloads/
**/eggs/
**/.lib/
**/parts/
**/sdist/
**/var/
**/wheels/
**/*.egg-info/

# ==========================================
# 4. Containerization (Docker)
# ==========================================
**/.dockerignore
# Remove the line above if Member 4 needs to track .dockerignore files, 
# but usually, they are tracked. Keep it tracked unless it holds secrets.

# ==========================================
# 5. Security & Environment Keys (CRITICAL)
# ==========================================
**/.env
**/.env.local
**/.env.*.local
**/local.properties
**/*.pem
**/*.key
**/config/jwt_secret.txt
